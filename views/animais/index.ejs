<%- include('../partials/header') %>

<h1>Animais disponíveis</h1>

<% if (usuario && usuario.tipo === 'administrador') { %>
  <p><a href="/animais/novo">Cadastrar novo animal</a></p>
<% } %>

<% if (animais.length === 0) { %>
  <p>Nenhum animal cadastrado ainda.</p>
<% } else { %>
  <% animais.forEach(function(animal) { %>
    <div>
      <h3><%= animal.nome %></h3>
      <p>Espécie: <%= animal.especie %></p>
      <p>Idade: <%= animal.idade %> ano(s)</p>
      <p>Sexo: <%= animal.sexo %></p>
      <p>Situação: <%= animal.situacao %></p>

      <% if (usuario && usuario.tipo === 'administrador') { %>
        <p><a href="/animais/<%= animal.id %>/editar">Editar</a></p>

        <form action="/animais/<%= animal.id %>/excluir" method="POST"
              onsubmit="return confirm('Tem certeza que deseja excluir este animal?');">
          <button type="submit">Excluir</button>
        </form>
      <% } %>

      <% if (animal.situacao === 'disponivel') { %>
        <% if (usuario && usuario.tipo === 'adotante') { %>
          <button class="btn-solicitar" data-id="<%= animal.id %>">Quero adotar</button>
          <p id="msg-<%= animal.id %>"></p>
        <% } else if (!usuario) { %>
          <p><a href="/login">Entre</a> para solicitar a adoção.</p>
        <% } %>
      <% } %>
    </div>
  <% }) %>
<% } %>

<script src="/js/solicitar.js"></script>

<%- include('../partials/footer') %>